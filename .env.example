# Pexels API key (free) — used to fetch stock video clips for each scene
# Get one at https://www.pexels.com/api/
PEXELS_API_KEY=

# Groq API key (free) — used to write video scripts via a hosted LLM.
# Get one at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Tavily API key (free tier) — used to fetch real, sourced facts for
# fact-dependent freeform themes (e.g. named-company stock analysis) before
# Groq writes the script, so it doesn't invent figures. Optional: if unset,
# those themes fall back to a "don't invent numbers" instruction instead.
# Get one at https://app.tavily.com
TAVILY_API_KEY=

# Gemini API key (free tier, from Google AI Studio) — used to generate the
# AI thumbnail/hook background image via Gemini 2.5 Flash Image. Optional: if
# unset, falls back straight to Pollinations.ai (no key needed) instead.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Cloudflare Workers AI (free tier, no credit card required) — second-tier AI
# thumbnail background generator, tried when Gemini is unconfigured, over its
# daily cap, or fails outright, before finally falling back to Pollinations.ai.
# Optional: if either is unset, falls back straight from Gemini to Pollinations.
# Get CLOUDFLARE_ACCOUNT_ID from the Cloudflare dashboard's Workers & Pages
# overview page (right-hand sidebar), and CLOUDFLARE_API_TOKEN from My Profile
# -> API Tokens -> Create Token (the "Workers AI" template).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional: Telegram bot, so you can request videos from your phone via chat
# instead of the web UI. See README for setup steps.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_CHAT_IDS=

