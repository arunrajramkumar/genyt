# Pexels API key (free) — used to fetch stock video clips for each scene
# Get one at https://www.pexels.com/api/
PEXELS_API_KEY=

# Ollama settings — used to write video scripts locally, no cost, no API key.
# Defaults are fine if Ollama runs on this machine with the default port.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
